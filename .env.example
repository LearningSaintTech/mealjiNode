NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/mealji
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
LOG_LEVEL=info
# Pretty logs need the pino-pretty devDependency. Defaults to on only when NODE_ENV=development.
LOG_PRETTY=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=mealji:

# JWT (two different secrets, each at least 32 characters)
ACCESS_TOKEN_SECRET=change-me-access-token-secret-32chars
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-32ch
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=60d
REFRESH_TOKEN_GRACE_SEC=180

# Cookies
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Google Maps Geocoding. Customer coordinates become a textual address. Kitchen addresses are placed for the service radius.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_REGION=in

# Temporary shared OTP for local sign-in, including when 2Factor is configured. Leave empty to use real SMS or the logged dev OTP. Must stay empty in production.
FIXED_OTP=123456

# 2Factor.in SMS OTP. Leave the key empty in local dev to use a logged OTP.
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE_NAME=OTPtemplate
TWOFACTOR_BASE_URL=https://2factor.in

# Store-review bypass is off unless explicitly enabled.
APPLE_REVIEW_OTP_ENABLED=false
APPLE_REVIEW_PHONE=
APPLE_REVIEW_OTP=

# First admin. Created unverified; sign in with the same phone OTP flow.
SEED_ADMIN_NAME=MealJi Admin
SEED_ADMIN_COUNTRY_CODE=+91
SEED_ADMIN_PHONE=

# Rate limits. These are the development values. Lower them in production.
OTP_RATE_LIMIT=100
OTP_RATE_WINDOW_SEC=3600
LOGIN_RATE_LIMIT=120
LOGIN_RATE_WINDOW_SEC=3600
VERIFY_OTP_RATE_LIMIT=120
VERIFY_OTP_RATE_WINDOW_SEC=3600
REFRESH_RATE_LIMIT=200
REFRESH_RATE_WINDOW_SEC=3600
OTP_IP_SOFT_LIMIT=1000
OTP_IP_SOFT_WINDOW_SEC=3600
RATE_LIMIT_REDIS_TIMEOUT_MS=2000
OTP_RESEND_COOLDOWN_SEC=45
OTP_MAX_ATTEMPTS=5
# Wrong OTPs allowed per account per 24 h (not reset by re-sending a code).
OTP_DAILY_FAILURE_LIMIT=20
LOCATION_RATE_LIMIT=100
LOCATION_RATE_WINDOW_SEC=3600

# Phase 0 – infrastructure
# docker compose up -d starts MongoDB as a replica set on 27018 and Redis on 6381:
#   MONGO_URI=mongodb://127.0.0.1:27018/mealji?replicaSet=rs0&directConnection=true
#   REDIS_PORT=6381
# Refuse to start without a replica set (always true in production).
MONGO_REQUIRE_REPLICA_SET=false
# The api also runs background workers (events, scheduled jobs). Set false in
# production and run `npm run worker` as a separate process.
RUN_WORKERS_IN_API=true
OUTBOX_RELAY_INTERVAL_MS=2000
# Bearer token for GET /metrics (Prometheus). Empty = open in dev, disabled in production.
METRICS_TOKEN=
IDEMPOTENCY_TTL_SEC=86400

# Public origin of this API (email links, local upload URLs, webhook URLs).
PUBLIC_BASE_URL=http://localhost:4000

# Files: "local" stores uploads under ./uploads (development only); "s3" uses pre-signed PUTs.
STORAGE_DRIVER=local
STORAGE_SECRET=
S3_BUCKET=
S3_REGION=ap-south-1
# Folder for every MealJi object (useful when the bucket is shared).
S3_KEY_PREFIX=mealji
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Razorpay. Empty in development = built-in test gateway. Required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Push (Firebase Cloud Messaging HTTP v1 service account). Empty = messages are logged.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp Business (Meta Cloud API). Empty = messages are logged.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# SMS sender ID for transactional SMS through 2Factor (DLT-registered header).
SMS_SENDER_ID=MEALJI

# Email (Amazon SES v2, uses the AWS keys above). Empty keys = emails are logged.
EMAIL_FROM=MealJi <no-reply@mealji.in>
SES_REGION=ap-south-1
# Shared token for the bounce/complaint webhook (?token=…).
EMAIL_WEBHOOK_TOKEN=

# Seed images: used when this machine cannot upload them (no S3, or no ../MealJi app folder).
# SEED_IMAGE_BASE_URL=https://d3bi5d5em13bi2.cloudfront.net/mealji/seed

# Extra hosts that tracked email links may redirect to (comma separated). PUBLIC_BASE_URL and CDN hosts are always allowed.
LINK_HOSTS=
