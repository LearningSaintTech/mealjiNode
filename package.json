{
  "name": "mealjinode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "test": "node --test --test-reporter=spec",
    "seed": "node scripts/seed.js",
    "postman:check": "node scripts/checkPostmanRoutes.js",
    "postman:sync": "node scripts/syncPostman.js",
    "smoke:home": "node scripts/smokeHome.js",
    "smoke:menu": "node scripts/smokeMenu.js",
    "test:steps": "node scripts/testSteps.js",
    "load:seed": "node --import ./scripts/load/loadEnv.js scripts/seed.js && node scripts/load/generate.js",
    "load:generate": "node scripts/load/generate.js",
    "load:api": "node scripts/load/api.js",
    "load:indexes": "node scripts/load/checkIndexes.js",
    "load:run": "node scripts/load/run.js",
    "load:api:profile": "node scripts/load/api.js --profile=45",
    "load:profile-top": "node scripts/load/profileTop.js",
    "load:api:opcount": "node scripts/load/api.js --opcount",
    "start:cluster": "node src/cluster.js",
    "load:api:cluster": "node --import ./scripts/load/loadEnv.js src/cluster.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "pino": "^9.11.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.1"
  }
}
